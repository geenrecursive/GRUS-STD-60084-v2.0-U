<style>
:root{
  --ink:#14181c; --mut:#55606a; --rule:#d3cfc8; --bg:#faf9f7; --card:#ffffff;
  --acc:#2f6690; --code:#f1efec; --box:#f6f5f3; --max:52rem;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --ink:#e9e6e0; --mut:#9aa3ab; --rule:#333b42; --bg:#14181c; --card:#191e23;
    --acc:#7fa8c9; --code:#1e242a; --box:#1c2228;
  }
}
:root[data-theme="dark"]{
  --ink:#e9e6e0; --mut:#9aa3ab; --rule:#333b42; --bg:#14181c; --card:#191e23;
  --acc:#7fa8c9; --code:#1e242a; --box:#1c2228;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);overflow-wrap:break-word;
  font-family:"Iowan Old Style","Palatino Linotype",Palatino,"Times New Roman",Times,serif;
  font-size:17px;line-height:1.62;-webkit-text-size-adjust:100%}
.wrap{max-width:84rem;margin:0 auto;padding:0 16px;display:flex;flex-direction:column}
@media(max-width:1099px){#toc{order:2}main{order:1}}
@media(min-width:1100px){.wrap{display:grid;grid-template-columns:17rem minmax(0,var(--max));justify-content:center;gap:3rem}}

/* masthead */
.mast{border-bottom:2px solid var(--ink);padding:26px 0 14px;margin-bottom:8px}
.mast .num{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;font-weight:700;
  font-size:1.05rem;letter-spacing:.06em;margin:0 0 4px}
.mast .ed{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.76rem;letter-spacing:.09em;
  color:var(--mut);margin:0 0 10px;text-transform:uppercase}
.mast .doi a{color:var(--acc);text-decoration:none;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.8rem}
.mast .doi a:hover{text-decoration:underline}

/* contents */
#toc{font-size:.84rem;line-height:1.45}
#toc .toch{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.7rem;letter-spacing:.12em;
  text-transform:uppercase;color:var(--mut);margin:0 0 8px}
#toc ol{list-style:none;margin:0;padding:0}
#toc li{margin:0 0 3px}
#toc a{color:var(--mut);text-decoration:none;display:block;padding:2px 6px;border-left:2px solid transparent}
#toc a:hover{color:var(--ink);border-left-color:var(--acc);background:var(--box)}
#toc .t3 a{padding-left:18px;font-size:.95em}
@media(min-width:1100px){#toc{position:sticky;top:18px;max-height:calc(100vh - 36px);overflow:auto;
  padding:18px 0 40px;border-right:1px solid var(--rule)}}
@media(max-width:1099px){#toc{border:1px solid var(--rule);background:var(--card);border-radius:6px;
  padding:14px;margin:16px 0 26px;max-height:19rem;overflow:auto}}

/* body */
main{padding:10px 0 80px;min-width:0}
h1{font-size:1.85rem;line-height:1.2;margin:.2em 0 .5em;font-weight:700}
h2{font-size:1.3rem;margin:2.3em 0 .6em;padding-bottom:.25em;border-bottom:1px solid var(--ink);scroll-margin-top:16px}
h3{font-size:1.08rem;margin:1.9em 0 .45em;scroll-margin-top:16px}
h4{font-size:.98rem;margin:1.5em 0 .35em;scroll-margin-top:16px}
p{margin:0 0 .85em}
ul,ol{margin:0 0 .9em;padding-left:1.4em}
li{margin-bottom:.35em}
a{color:var(--acc)}
.pl{opacity:0;margin-left:.4em;font-size:.72em;text-decoration:none;color:var(--acc)}
h2:hover .pl,h3:hover .pl,h4:hover .pl{opacity:.7}
a.ref{text-decoration:none;border-bottom:1px solid var(--acc)}

/* devices from the print edition */
.ctr{text-align:center}
.std{font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:700;letter-spacing:.06em}
.m{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.92em}
.sub{font-style:italic}
.meta{font-size:.9rem;color:var(--mut)}
.note{font-size:.88rem;color:var(--mut)}
hr.top{height:2px;background:var(--ink);border:0;margin:1.4em 0}
.calc{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.82rem;line-height:1.5;
  background:var(--code);border:1px solid var(--rule);border-radius:4px;padding:12px 14px;
  margin:1em 0;white-space:pre;overflow-x:auto}
.box{border:1.5px solid var(--ink);background:var(--box);border-radius:4px;padding:14px 16px;margin:1.2em 0}
.box p:last-child{margin-bottom:0}
.i2{margin-left:1.2em}
.r{text-align:right}
.c{text-align:center}

/* jurisdictional entry device */
.je{white-space:nowrap}
.jn{font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:700;font-size:.72rem;
  background:var(--ink);color:var(--bg);padding:1px 5px;border-radius:2px;letter-spacing:.03em}
.jt{font-size:.66rem;text-transform:uppercase;letter-spacing:.05em;background:var(--rule);
  color:var(--ink);border:1px solid var(--ink);border-left:0;padding:1px 5px;font-weight:700}
.jr,.jrs,.jrl{display:inline-block;border-bottom:1px solid var(--ink);height:.85em;vertical-align:bottom}
.jr{min-width:7rem}.jrs{min-width:3.6rem}.jrl{min-width:13rem}
.jd{font-size:.86em;font-style:italic;color:var(--mut)}

/* phones and small tablets: the entry device wraps instead of running off the page */
@media(max-width:760px){
  .je{white-space:normal;display:inline-block;max-width:100%}
  .jr,.jrs,.jrl{display:block;min-width:0!important;width:100%;max-width:20rem;height:1.05em;margin:3px 0 2px}
  .jn,.jt{display:inline-block;white-space:nowrap}
  .calc{font-size:.76rem}
  body{font-size:16.5px}
  h1{font-size:1.5rem}h2{font-size:1.18rem}h3{font-size:1.03rem}
}
/* never let a long token drag the page sideways */
a,code,.m,.std{overflow-wrap:anywhere}
img,svg{max-width:100%;height:auto}

/* tables */
.tw{overflow-x:auto;margin:1em 0;-webkit-overflow-scrolling:touch}
table{border-collapse:collapse;width:100%;font-size:.86rem;line-height:1.45;min-width:34rem}
th,td{border:1px solid var(--rule);padding:7px 9px;text-align:left;vertical-align:top}
th{background:var(--box);font-weight:700}
table.sched td:first-child{white-space:nowrap}

/* footer */
.foot{border-top:1px solid var(--rule);margin-top:3rem;padding:18px 0 60px;font-size:.84rem;color:var(--mut)}
.foot a{color:var(--acc)}

/* print: fall back to the printed edition's look */
@media print{
  :root{--ink:#000;--bg:#fff;--mut:#333;--rule:#777;--box:#f4f4f4;--code:#f4f4f4;--acc:#000}
  body{font-family:"Times New Roman",Times,serif;font-size:10.6pt;line-height:1.42}
  #toc,.pl,.themebtn{display:none!important}
  .wrap{display:block;max-width:none;padding:0}
  h2{page-break-after:avoid}.box,.calc,table{page-break-inside:avoid}
  a{color:#000;text-decoration:none}
}
.themebtn{position:fixed;right:14px;bottom:14px;z-index:20;background:var(--card);color:var(--mut);
  border:1px solid var(--rule);border-radius:999px;padding:7px 13px;font:600 .72rem/1 ui-monospace,Menlo,monospace;
  letter-spacing:.08em;cursor:pointer}
.themebtn:hover{color:var(--ink);border-color:var(--acc)}
</style>
